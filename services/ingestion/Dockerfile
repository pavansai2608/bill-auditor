# ingestion-service: PDFs to clauses to embeddings.
# Heavy but rare; it is the only image that needs the policy PDFs.
# Multi-stage: the wheels are built once, then copied into a slim runtime.
FROM python:3.14-slim AS builder
WORKDIR /build
RUN pip install --no-cache-dir uv
# Line 3 of the requirements file is `-e .`, so the install builds this project
# too. That needs the package source and the readme pyproject names, not just
# the metadata files.
#
# One file per service, generated by `uv export` from the extras in
# pyproject.toml. Installing the full set here cost 8.82 GB per image, four
# times over, because sentence-transformers pulls torch and the CUDA wheels
# even into services that never embed anything.
COPY pyproject.toml uv.lock requirements-ingestion.txt README.md ./
COPY src/ ./src/
# The CPU wheel index, because the lock pins torch==2.14.0+cpu, which only
# exists there. PyPI's linux torch is the CUDA build and brings nvidia-*
# (2.9 GB) and triton (650 MB) with it, for a service that has no GPU to
# use them on. unsafe-best-match is required: the default stops at the
# first index carrying the name, and PyPI carries `torch` without +cpu.
RUN uv pip install --system --no-cache \
      --extra-index-url https://download.pytorch.org/whl/cpu \
      --index-strategy unsafe-best-match \
      -r requirements-ingestion.txt

FROM python:3.14-slim
WORKDIR /app
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
COPY --from=builder /usr/local/lib/python3.14/site-packages /usr/local/lib/python3.14/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin
# core/ is the shared library. Every Python service copies the same one rather
# than reimplementing a rule.
COPY core/ ./core/
COPY api/ ./api/
COPY services/ ./services/
COPY data/clauses.json data/non_payable.json ./data/
COPY data/policies/ ./data/policies/
EXPOSE 8000
# /ready, not /health: this service loads an embedding model (and a
# cross-encoder) at startup, and compose should not report it healthy - or let
# a dependent service start - until that is done. start-period covers the load.
# start-period is minutes, not seconds: a fresh container has no HuggingFace
# cache, so the warm-up downloads bge-base and the cross-encoder before it can
# load them. Measured at 606s on this machine. Baking the weights into the
# image would remove that wait at the cost of about a gigabyte.
HEALTHCHECK --interval=15s --timeout=10s --start-period=900s --retries=3 \
  CMD python -c "import urllib.request;urllib.request.urlopen('http://localhost:8000/ready')"
CMD ["uvicorn", "services.ingestion.main:app", "--host", "0.0.0.0", "--port", "8000"]
