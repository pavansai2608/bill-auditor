# The GitHub Pages build: `npm run build:pages`.
#
# Committed on purpose. Nothing here is a secret - it is three facts about
# where the static site is hosted, all of them visible in the URL bar. No API
# key, no token and no private host belongs in this file or in the bundle it
# produces; a static site has no private half.

# The site lives at https://pavansai2608.github.io/bill-auditor/ - a subpath.
# Vite writes every asset URL under it and exposes it as import.meta.env.BASE_URL,
# which main.tsx hands to the router as its basename.
VITE_BASE_PATH=/bill-auditor/

# Pages has no rewrite rule, so index.html is copied to 404.html at the end of
# the build and a deep link survives a hard refresh.
VITE_SPA_404=true

# There is no backend on Pages. The audit is a local RAG pipeline over a clause
# index and an 8B model; none of that is deployed publicly. This makes the app
# say so and disable the submit path, instead of posting into nothing.
VITE_STATIC_DEMO=true

# Deliberately empty. Left unset, lib/api.ts would fall back to
# http://localhost:8000, which is a private host that would sit in a public
# bundle and fail for every visitor.
VITE_API_BASE=
