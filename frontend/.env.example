# The API base URL. Defaults to http://localhost:8000 when unset.
# docker-compose sets this to the gateway; minikube sets it to the service.
VITE_API_BASE=http://localhost:8000

# --------------------------------------------------------------------------
# The three below belong to the GitHub Pages build and are set in .env.pages,
# which is committed. They are listed here so nothing else quietly acquires
# them: set any of these for a normal build and you get a subpath build, a
# stray 404.html, or a form that refuses to submit.
#
# Nothing that a Vite build inlines is private. A VITE_ variable is a string
# in a file anyone can fetch off the published site, so an API key must never
# be one - not here, not in .env.pages, not in the workflow.
# --------------------------------------------------------------------------

# The subpath the site is served from, e.g. /bill-auditor/. Vite writes every
# asset URL under it and exposes it as import.meta.env.BASE_URL, which
# main.tsx hands the router as its basename. Unset means "/".
# VITE_BASE_PATH=

# Copy index.html to 404.html after the build. GitHub Pages has no rewrite
# rule, so this is what makes a hard refresh on a deep link work.
# VITE_SPA_404=

# "There is no backend." Disables the submit path and explains why, rather
# than posting into nothing, and blanks the localhost API base so no private
# host reaches a public bundle.
# VITE_STATIC_DEMO=
