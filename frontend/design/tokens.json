{
  "$comment": "The design system for both screens. The stylesheet mirrors these keys one-for-one as CSS variables, so this file is the single source of the look. Brief: calm, trustworthy, medical-adjacent; one accent colour; the deducted figure is the emotional centre of the report.",
  "colour": {
    "ink": "#0B1F2A",
    "ink-muted": "#55707E",
    "ink-faint": "#8AA2AE",
    "surface": "#FFFFFF",
    "surface-sunken": "#F4F7F8",
    "surface-raised": "#FBFCFD",
    "border": "#DDE6EA",
    "border-strong": "#C3D2D9",
    "accent": "#0E7C7B",
    "accent-hover": "#0A5F5E",
    "accent-soft": "#E4F2F1",
    "accent-ink": "#FFFFFF",
    "flag": "#9A6410",
    "flag-soft": "#FDF4E5",
    "flag-border": "#EAD5AE",
    "deduct": "#8C2F2F",
    "deduct-soft": "#FBF0F0",
    "focus": "#0E7C7B"
  },
  "text": {
    "caption": "0.75rem",
    "small": "0.8125rem",
    "body": "0.9375rem",
    "lead": "1.0625rem",
    "heading": "1.375rem",
    "title": "1.75rem",
    "figure": "2rem",
    "display": "3rem"
  },
  "weight": { "regular": 400, "medium": 500, "semibold": 600 },
  "leading": { "tight": 1.2, "normal": 1.5, "loose": 1.65 },
  "space": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "24px",
    "6": "32px",
    "7": "48px",
    "8": "64px"
  },
  "radius": { "sm": "6px", "md": "10px", "lg": "14px", "pill": "999px" },
  "shadow": {
    "card": "0 1px 2px rgba(11, 31, 42, 0.04), 0 1px 3px rgba(11, 31, 42, 0.06)",
    "raised": "0 2px 8px rgba(11, 31, 42, 0.08)"
  },
  "layout": {
    "page-max": "1120px",
    "form-max": "720px",
    "breakpoint-mobile": "760px",
    "control-height": "42px"
  },
  "font": {
    "sans": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
    "mono": "'SF Mono', ui-monospace, 'JetBrains Mono', Menlo, monospace"
  },
  "motion": { "fast": "120ms ease", "normal": "200ms ease" }
}
