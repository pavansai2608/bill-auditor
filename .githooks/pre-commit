#!/bin/sh
# Blocks the commit when ruff finds a lint error in staged Python files.
# Install with: git config core.hooksPath .githooks

set -e

# --- secrets ------------------------------------------------------------
# Before anything else, because a leaked key cannot be un-leaked by a later
# commit. .env is gitignored, but `git add -f` and a stray copy called
# `.env.local` both get past that, and an API key pasted into a source file
# gets past it entirely.
STAGED_ALL=$(git diff --cached --name-only --diff-filter=ACM)

for FILE in $STAGED_ALL; do
    case "$FILE" in
        .env|.env.*|*/.env|*/.env.*)
            # Matched on the basename, not the path. The exemption used to be
            # the exact string ".env.example", so frontend/.env.example - a
            # committed template that has always been in the repo - was blocked
            # the moment the front end grew one of its own.
            #
            # .env.pages is committed on purpose too: it holds three facts about
            # where the static site is hosted, all of them visible in the URL
            # bar. Nothing a Vite build inlines can be private anyway - a VITE_
            # variable is a string anyone can fetch off the published site - and
            # the key scan below still reads the content of both.
            case "${FILE##*/}" in
                .env.example|.env.pages) ;;
                *)
                    echo "pre-commit: BLOCKED - refusing to commit $FILE." >&2
                    echo "  It is meant to hold secrets and is gitignored." >&2
                    echo "  Unstage it: git restore --staged $FILE" >&2
                    exit 1
                    ;;
            esac
            ;;
    esac
done

# A Groq key is gsk_ followed by ~52 characters. Checked in the staged content
# rather than the file list, so it is caught wherever it was pasted.
if git diff --cached -- . ':(exclude).githooks/pre-commit' | grep -qE '^\+.*gsk_[A-Za-z0-9]{20,}'; then
    echo "pre-commit: BLOCKED - that looks like a Groq API key." >&2
    echo "  Keys belong in .env, which is gitignored. See .env.example." >&2
    echo "  If it has already been pushed, revoke it at" >&2
    echo "  https://console.groq.com/keys rather than just removing the line." >&2
    exit 1
fi

STAGED=$(git diff --cached --name-only --diff-filter=ACM -- '*.py')

if [ -z "$STAGED" ]; then
    exit 0
fi

if command -v uv >/dev/null 2>&1; then
    RUFF="uv run ruff"
elif [ -x .venv/bin/ruff ]; then
    RUFF=".venv/bin/ruff"
else
    echo "pre-commit: ruff not found; install it with 'uv sync'" >&2
    exit 1
fi

echo "pre-commit: ruff check on $(echo "$STAGED" | wc -l | tr -d ' ') staged file(s)"

# shellcheck disable=SC2086
if ! $RUFF check $STAGED; then
    echo "" >&2
    echo "pre-commit: BLOCKED - ruff reported problems." >&2
    echo "  fix them, or run 'uv run ruff check --fix' then re-stage." >&2
    exit 1
fi

# shellcheck disable=SC2086
if ! $RUFF format --check $STAGED; then
    echo "" >&2
    echo "pre-commit: BLOCKED - formatting differs." >&2
    echo "  run 'uv run ruff format' then re-stage." >&2
    exit 1
fi

exit 0
