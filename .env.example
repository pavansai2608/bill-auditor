# Copy to .env and adjust. .env is gitignored; never commit real values.
# All settings are read by core/config.py with the BA_ prefix.

BA_OLLAMA_BASE_URL=http://localhost:11434
BA_OLLAMA_MODEL=qwen3:8b
BA_NUM_CTX=8192
BA_TEMPERATURE=0.0
BA_KEEP_ALIVE=30m

BA_LLM_CACHE_ENABLED=true

BA_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
BA_RERANKER_MODEL=BAAI/bge-reranker-base

BA_LOG_LEVEL=INFO
BA_LLM_REASONING=false
BA_LLM_NUM_PREDICT=2048
