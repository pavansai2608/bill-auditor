# Copy to .env and adjust. .env is gitignored; never commit real values.
# All settings are read by core/config.py with the BA_ prefix.

BA_OLLAMA_BASE_URL=http://localhost:11434
BA_OLLAMA_MODEL=qwen3:8b
BA_NUM_CTX=8192
BA_TEMPERATURE=0.0
BA_KEEP_ALIVE=30m

BA_LLM_CACHE_ENABLED=true

BA_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
BA_RERANKER_MODEL=BAAI/bge-reranker-base

BA_LOG_LEVEL=INFO
BA_LLM_REASONING=false
BA_LLM_NUM_PREDICT=2048

# --- Which backend answers ---------------------------------------------
# Blank uses the per-context default from core/config.py: groq for the API and
# the UI, ollama for the eval, the CLI and the tests. Setting this overrides
# all of them, which is how docker and k8s choose without a code change.
BA_LLM_BACKEND=

# --- Groq ---------------------------------------------------------------
# Free key from https://console.groq.com/keys - sign in, "Create API Key".
# Free tier: 30 requests and 6,000 tokens a minute, 1,000 requests a day. The
# token cap is the one that binds. Never commit a real key; .env is gitignored.
BA_GROQ_API_KEY=
BA_GROQ_MODEL=openai/gpt-oss-120b
BA_GROQ_TOKENS_PER_MINUTE=8000
BA_GROQ_REQUESTS_PER_MINUTE=30
BA_GROQ_REQUESTS_PER_DAY=1000
